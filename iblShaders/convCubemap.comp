#version 460 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (binding = 0) uniform samplerCube uInputCubemap;
layout (rgba16f, binding = 0) uniform writeonly imageCube uOutputCubemap;

const float PI = 3.1415926535;

vec3 getTexelCoords(vec2 uv, uint faceID){
	vec2 st = uv * 2.0 - 1.0;
	vec3 dir;

	switch(faceID){
		case 0: dir = vec3(1.0, -st.y, -st.x); break;
		case 1: dir = vec3(-1.0, -st.y, st.x); break;
		case 2: dir = vec3(st.x, 1.0, st.y); break;
		case 3: dir = vec3(st.x, -1.0, -st.y); break;
		case 4: dir = vec3(st.x, -st.y, 1.0); break;
		case 5: dir = vec3(-st.x, -st.y, -1.0); break;
	}
	return normalize(dir);
}

void main(){
	ivec3 texCoords = ivec3(gl_GlobalInvocationID.xyz);
	ivec2 size = imageSize(uOutputCubemap);

	if(texCoords.x >= size.x || texCoords.y >= size.y) return;
	vec2 uv = (vec2(texCoords.xy) + 0.5) / vec2(size);
	vec3 normal = getTexelCoords(uv, uint(texCoords.z));
	vec3 irradiance = vec3(0.0);

	vec3 up = vec3(0.0, 1.0, 0.0);
	vec3 right = normalize(cross(up, normal));

	if(length(right) == 0.0){
		up = vec3(0.0, 0.0, 1.0);
		right = normalize(cross(up, normal));
	}
	up = normalize(cross(normal, right));

	float sampleDelta = 0.025;
	float nrSamples = 0.0;
	for(float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta){
		for(float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta){
			vec3 tangentSample = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
			vec3 sampleVec = tangentSample.x * right + tangentSample.y * up + tangentSample.z * normal;

			irradiance += texture(uInputCubemap, sampleVec).rgb * cos(theta) * sin(theta);
			nrSamples++;
		}
	}
	irradiance = PI * irradiance * (1.0 / float(nrSamples));

	imageStore(uOutputCubemap, texCoords, vec4(irradiance, 1.0));
}

