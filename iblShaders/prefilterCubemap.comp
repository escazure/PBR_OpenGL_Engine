#version 460 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (binding = 0) uniform samplerCube uEnvironmentCubemap;
layout (rgba16f, binding = 0) uniform writeonly imageCube uOutputCubemap;

uniform float uRoughness;

const float PI = 3.1415926535;

float RadicalInverse_VdC(uint bits){
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N){
	return vec2(float(i)/float(N), RadicalInverse_VdC(i));
}

vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness){
	float a = roughness * roughness;
	float phi = 2.0 * PI * Xi.x;
	float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y));
	float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

	vec3 H;
	H.x = cos(phi) * sinTheta;
	H.y = sin(phi) * sinTheta;
	H.z = cosTheta;

	vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 tangent = normalize(cross(up, N));
	vec3 bitangent = cross(N, tangent);

	return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

vec3 getTexelCoords(vec2 uv, uint faceID){
	vec2 st = uv * 2.0 - 1.0;
	vec3 dir;

	switch(faceID){
		case 0: dir = vec3(1.0, -st.y, -st.x); break;
		case 1: dir = vec3(-1.0, -st.y, st.x); break;
		case 2: dir = vec3(st.x, 1.0, st.y); break;
		case 3: dir = vec3(st.x, -1.0, -st.y); break;
		case 4: dir = vec3(st.x, -st.y, 1.0); break;
		case 5: dir = vec3(-st.x, -st.y, -1.0); break;
	}
	return normalize(dir);
}

void main(){
	ivec3 texCoords = ivec3(gl_GlobalInvocationID.xyz);
	ivec2 size = imageSize(uOutputCubemap);
	
	if(texCoords.x >= size.x || texCoords.y >= size.y) return;
	vec2 uv = (vec2(texCoords.xy) + 0.5) / vec2(size);
	vec3 N = getTexelCoords(uv, texCoords.z);

	vec3 R = N;
	vec3 V = R;

	const uint SAMPLE_COUNT = 1024u;	
	float totalWeight = 0.0;
	vec3 prefilteredColor = vec3(0.0);
	for(uint i = 0u; i < SAMPLE_COUNT; i++){
		vec2 Xi = Hammersley(i, SAMPLE_COUNT);
		vec3 H = ImportanceSampleGGX(Xi, N, uRoughness);
		vec3 L = normalize(2.0 * dot(V, H) * H - V);

		float NdotL = max(dot(N, L), 0.0);
		if(NdotL > 0.0){
			prefilteredColor += texture(uEnvironmentCubemap, L).rgb * NdotL;
			totalWeight += NdotL;
		}
	}

	vec3 finalColor = totalWeight > 0.0 ? prefilteredColor / totalWeight : vec3(0.0);
	imageStore(uOutputCubemap, texCoords, vec4(finalColor, 1.0));
}
